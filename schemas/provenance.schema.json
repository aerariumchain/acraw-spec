{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerariumchain.github.io/acraw-spec/schemas/0.1/provenance.schema.json",
  "title": "AerariumChain Raw provenance",
  "type": "object",
  "required": [
    "conversions"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scheme",
              "value"
            ],
            "properties": {
              "scheme": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "holder": {
          "type": "string"
        }
      }
    },
    "acquisition": {
      "type": "object",
      "properties": {
        "organization": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "environment": {
          "type": "object"
        }
      }
    },
    "software": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "conversions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "date"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "properties": {
        "rights_holder": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "extras": {
      "type": "object"
    }
  }
}
