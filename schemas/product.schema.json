{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerariumchain.github.io/acraw-spec/schemas/0.1/product.schema.json",
  "title": "AerariumChain Raw derived product",
  "type": "object",
  "required": [
    "id",
    "kind",
    "inputs",
    "software",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {
      "enum": [
        "fused_mesh",
        "dense_cloud",
        "sparse_cloud",
        "textured_model",
        "orthophoto",
        "depth_maps",
        "mask_set",
        "alignment",
        "qc_report",
        "measurement",
        "other"
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "captures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "products": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "software": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "path"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          }
        }
      }
    },
    "extras": {
      "type": "object"
    }
  }
}
