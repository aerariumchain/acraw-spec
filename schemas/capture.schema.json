{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerariumchain.github.io/acraw-spec/schemas/0.1/capture.schema.json",
  "title": "AerariumChain Raw capture",
  "type": "object",
  "required": [
    "id",
    "kind",
    "sensors",
    "payloads"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {
      "enum": [
        "range_grid",
        "image",
        "tls_scan",
        "point_cloud",
        "line_profile",
        "volume",
        "trajectory"
      ]
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "timestamp_ns": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "active",
        "deleted"
      ]
    },
    "grid": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "path"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sensor": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "ply_properties": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "vendor_metrics": {
      "type": "object"
    },
    "vendor_properties": {
      "type": "object"
    },
    "vendor_raw_properties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "encoding",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "encoding": {
            "enum": [
              "hex",
              "base64"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "extras": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "range_grid"
          }
        }
      },
      "then": {
        "required": [
          "grid"
        ]
      }
    }
  ]
}
